# Copie para .streamlit/secrets.toml (local) ou cole no painel
# "Secrets" do Streamlit Community Cloud.
# Nunca committe o arquivo real com chaves.

AWS_ACCESS_KEY_ID = "sua_access_key_id"
AWS_SECRET_ACCESS_KEY = "sua_secret_access_key"
AWS_DEFAULT_REGION = "us-east-1"
AWS_BUCKET_NAME = "canadapt-data-lake-gf"
AWS_S3_BUCKET_NAME = "canadapt-data-lake-gf"
