ADZUNA_APP_ID=seu_app_id_real
ADZUNA_APP_KEY=sua_app_key_real
JOOBLE_API_KEY=sua_chave_guid_do_jooble

GEMINI_API_KEY=sua_gemini_api_key

AWS_ACCESS_KEY_ID=sua_access_key_id
AWS_SECRET_ACCESS_KEY=sua_secret_access_key
AWS_DEFAULT_REGION=us-east-1
# Preferido pelo script de custo de vida; Adzuna usa AWS_S3_BUCKET_NAME.
AWS_BUCKET_NAME=canadapt-data-lake-gf
AWS_S3_BUCKET_NAME=canadapt-data-lake-gf

# GitHub Actions (Settings → Secrets and variables → Actions):
# ADZUNA_APP_ID, ADZUNA_APP_KEY, JOOBLE_API_KEY, GEMINI_API_KEY,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION,
# AWS_BUCKET_NAME, AWS_S3_BUCKET_NAME
# Workflow: .github/workflows/weekly_pipeline.yml (quartas 12:00 Brasília / 15:00 UTC)
#
# Streamlit Community Cloud (Secrets da app) — só leitura da Gold:
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION,
# AWS_BUCKET_NAME, AWS_S3_BUCKET_NAME
# Limite de vagas por run (custo Gemini).
CANADAPT_MAX_JOBS_PER_RUN=500
# Job Bank (sem API key): LMIA + internacionais via busca pública.
CANADAPT_MAX_JOBBANK_JOBS=200
CANADAPT_JOBBANK_MAX_PAGES=40
# Restaura só partições hive dos últimos N dias + caches/wages.
CANADAPT_LAKE_RETENTION_DAYS=90
# 1 = CI publica Gold mesmo se Gemini estiver 503 (status degraded).
CANADAPT_ALLOW_GEMINI_DEGRADED=1

